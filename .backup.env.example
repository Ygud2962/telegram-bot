# This file is read only by scripts/backup-postgres.sh. Copy it to .backup.env
# on the VPS and never commit the copy.

# Store a recent on-server copy. Use an absolute path outside the source tree.
BACKUP_DIR=/var/backups/school-bot
BACKUP_RETENTION_DAYS=14

# Optional off-server copy. Configure the remote with `rclone config` first.
# Example: BACKUP_RCLONE_TARGET=active-storage:school-bot-postgres
BACKUP_RCLONE_TARGET=
