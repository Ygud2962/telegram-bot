BOT_TOKEN=your_telegram_bot_token
# Docker Compose: postgresql://school_bot:URL_ENCODED_PASSWORD@db:5432/school_bot
# External managed database: use its connection URL and keep DB_SSLMODE=require.
DATABASE_URL=postgresql://school_bot:change_me@db:5432/school_bot
DB_SSLMODE=disable

# PostgreSQL container. Generate a unique long password; URL-encode it in DATABASE_URL.
POSTGRES_DB=school_bot
POSTGRES_USER=school_bot
POSTGRES_PASSWORD=change_me_to_a_long_unique_password

# Optional AI assistant key
GROQ_API_KEY=

# Public game and backend URLs. DOMAIN is used by Caddy to issue HTTPS certificates.
DOMAIN=bot.example.by
GAME_URL=https://bot.example.by/game/
BOT_PUBLIC_URL=https://bot.example.by

# Runtime
PORT=8080
BOT_VERSION=9.8.0
GAME_VERSION=1.7.78
ZDNET_VERSION=0.1.0
PROJECT_AUTHOR_LABEL=Автор проекта
PROJECT_AUTHOR_URL=https://t.me/Yury_hud
DB_STARTUP_MAX_WAIT_SEC=300
DB_STARTUP_RETRY_SEC=5

# Game access and auth
GAME_BETA=0
GAME_AUTH_REQUIRED=1
GAME_AUTH_TTL_SEC=86400

# Diagnostics / tuning
SLOW_DB_MS=350
SLOW_CALLBACK_MS=1000
MAX_AI_HISTORY_USERS=2000
AI_HISTORY_TTL_SEC=86400
